{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "forms-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_USE_MOCK=true npx vite --host --port 5176"
      ],
      "port": 5176,
      "autoPort": true
    },
    {
      "name": "forms-app",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd forms-app && npx vite --host --port 5177"
      ],
      "port": 5177,
      "autoPort": true
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_API_BASE=http://127.0.0.1:9 npx vite --host --port 5279"
      ],
      "port": 5279,
      "autoPort": true
    },
    {
      "name": "crispr-api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "localhost:3000",
        "-t",
        "../CrisprTechApp"
      ],
      "port": 3000
    },
    {
      "name": "legacy-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180"
      ],
      "port": 5180
    }
  ]
}